<Window
    x:Class="Starsky.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <Style x:Key="MenuStripButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#33000000" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="2" Padding="6,2">
                <Button Content="File" Style="{StaticResource MenuStripButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="New Window" Click="NewWindow_Click" />
                            <MenuFlyoutItem Text="Edit File In Editor" Click="EditFile_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Content="Settings" Style="{StaticResource MenuStripButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Connection Settings" Click="ConnectionSettings_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Content="Develop" Style="{StaticResource MenuStripButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Refresh" Click="Refresh_Click" />
                            <MenuFlyoutItem Text="Dev Tools" Click="DevTools_Click" />
                            <MenuFlyoutItem Text="Open In Browser" Click="OpenInBrowser_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Content="Help" Style="{StaticResource MenuStripButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Documentation" Click="Documentation_Click" />
                            <MenuFlyoutItem Text="Release Overview" Click="ReleaseOverview_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel x:Name="TabStripPanel" Orientation="Horizontal" Padding="0,0" Spacing="0" VerticalAlignment="Bottom" />
                </ScrollViewer>
            </Border>

            <Grid x:Name="BrowserHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>