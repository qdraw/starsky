<Window x:Class="Starsky.Desktop.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starsky — Update Available"
        Width="440" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="A newer version of Starsky is available."
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Click 'Update Now' to download and install the latest version. The app will restart automatically."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="#555"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Update Now"
                    Width="100"
                    Margin="0,0,8,0"
                    Click="UpdateButton_Click"/>
            <Button Content="Close"
                    Width="80"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
