<Window x:Class="Starsky.Desktop.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Starsky"
        Width="320" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1a1a2e">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Starsky"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#e0e0e0"
                   HorizontalAlignment="Center"/>

        <TextBlock x:Name="VersionText"
                   Grid.Row="2"
                   FontSize="12"
                   Foreground="#aaa"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="4"
                   Text="© Qdraw"
                   FontSize="11"
                   Foreground="#666"
                   HorizontalAlignment="Center"/>

        <Button Grid.Row="6"
                Content="OK"
                Width="80"
                HorizontalAlignment="Center"
                Click="OK_Click"
                Background="#2a2a4e"
                Foreground="#e0e0e0"
                BorderBrush="#444"
                Padding="0,4"/>
    </Grid>
</Window>
